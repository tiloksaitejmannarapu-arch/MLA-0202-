import numpy as np
import matplotlib.pyplot as plt
from sklearn.preprocessing import StandardScaler
from sklearn.cluster import KMeans
from sklearn.decomposition import PCA
from sklearn.metrics import silhouette_score

data = np.array([
    [19, 15, 39],
    [21, 15, 81],
    [20, 16, 6],
    [23, 16, 77],
    [31, 17, 40],
    [22, 17, 76],
    [35, 18, 6],
    [23, 18, 94],
    [64, 19, 3],
    [30, 19, 72]
])

age = data[:, 0]
income = data[:, 1]
spending = data[:, 2]

print("CUSTOMER SEGMENTATION USING K-MEANS")
print("------------------------------------")
print("Total customers:", len(data))

X = data[:, 1:3]

scaler = StandardScaler()
X_scaled = scaler.fit_transform(X)

print("\nData preprocessing completed.")
print("Features used: Annual Income and Spending Score")

scores = []

for k in range(2, 6):
    model = KMeans(n_clusters=k, random_state=42, n_init=10)
    labels = model.fit_predict(X_scaled)
    score = silhouette_score(X_scaled, labels)
    scores.append(score)

best_k = range(2, 6)[np.argmax(scores)]

print("\nSilhouette Scores:")

for k, score in zip(range(2, 6), scores):
    print("K =", k, "->", round(score, 3))

print("\nOptimal number of clusters:", best_k)

kmeans = KMeans(n_clusters=best_k, random_state=42, n_init=10)
clusters = kmeans.fit_predict(X_scaled)

pca = PCA(n_components=2)
X_pca = pca.fit_transform(X_scaled)

print("\nPCA Analysis")
print("------------")
print("Explained variance ratio:",
      np.round(pca.explained_variance_ratio_, 3))
print("Total variance explained:",
      round(sum(pca.explained_variance_ratio_) * 100, 2), "%")

print("\nCustomer Cluster Assignment")
print("---------------------------")

for i in range(len(data)):
    print("Customer", i + 1,
          "-> Cluster", clusters[i] + 1,
          "| Income =", int(income[i]),
          "| Spending Score =", int(spending[i]))

print("\nCluster Sizes")
print("-------------")

for c in range(best_k):
    count = np.sum(clusters == c)
    print("Cluster", c + 1, ":", count, "customers")

inertia = []

for k in range(1, 7):
    model = KMeans(n_clusters=k, random_state=42, n_init=10)
    model.fit(X_scaled)
    inertia.append(model.inertia_)

plt.figure(figsize=(7, 5))
plt.plot(range(1, 7), inertia, marker='o')
plt.xlabel("Number of Clusters (K)")
plt.ylabel("Within-Cluster Sum of Squares")
plt.title("Elbow Method for Optimal K")
plt.grid(True)
plt.show()

plt.figure(figsize=(7, 5))
plt.plot(range(2, 6), scores, marker='o')
plt.xlabel("Number of Clusters (K)")
plt.ylabel("Silhouette Score")
plt.title("Silhouette Score Comparison")
plt.grid(True)
plt.show()

plt.figure(figsize=(8, 6))

for c in range(best_k):
    points = X_scaled[clusters == c]
    plt.scatter(points[:, 0], points[:, 1],
                s=100, label="Cluster " + str(c + 1))

centers = kmeans.cluster_centers_

plt.scatter(centers[:, 0], centers[:, 1],
            marker='X', s=200, label="Centroids")

plt.xlabel("Standardized Annual Income")
plt.ylabel("Standardized Spending Score")
plt.title("Customer Segmentation using K-Means")
plt.legend()
plt.grid(True)
plt.show()

plt.figure(figsize=(8, 6))

for c in range(best_k):
    points = X_pca[clusters == c]
    plt.scatter(points[:, 0], points[:, 1],
                s=100, label="Cluster " + str(c + 1))

plt.xlabel("Principal Component 1")
plt.ylabel("Principal Component 2")
plt.title("Customer Clusters after PCA")
plt.legend()
plt.grid(True)
plt.show()

print("\nFINAL INTERPRETATION")
print("--------------------")
print("K-Means successfully divided customers into",
      best_k, "groups.")
print("PCA transformed the customer features into two")
print("principal components for easier visualization.")
print("Customers within the same cluster have similar")
print("income and spending behavior.")
